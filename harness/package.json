{
  "name": "ripcord-harness",
  "private": true,
  "type": "module",
  "description": "Measures Ripcord's loop per hop: swap mined \u2192 Lasna react seen \u2192 exit seen, by wall clock and on-chain blocks.",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "measure": "tsx --env-file=../.env src/measure.ts",
    "reversals": "tsx --env-file=../.env src/reversals.ts"
  },
  "dependencies": {
    "viem": "2.57.16"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
