# Names and purposes are in docs/CONTEXT.md (Environment). Never put private keys here:
# keys live in a Foundry keystore (`cast wallet import ripcord-deployer --interactive`).
LASNA_RPC=
UNICHAIN_SEPOLIA_RPC=
BASE_SEPOLIA_RPC=
SEPOLIA_RPC=
DEPLOYER_ADDRESS=
# Path to the keystore password file (outside the repo), so scripts can sign without a prompt
KEYSTORE_PASSWORD_FILE=
# Foundry keystore account name used by the spike scripts (the key itself stays in ~/.foundry/keystores)
ACCOUNT=
# Set to 1 only if Lasna rejects EIP-1559 transactions
LASNA_LEGACY=
